# Protect local archives and reports from earlier checkouts.
/downloads/*.zip
/reports/latest_run.md
/reports/v7_browser_verification.json

# vNext private runtime. Inspection contains generated synthetic summaries only.
/.venv-vnext/
/runtime/
/Daily_Stock_*.csv
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*
/work/

# Playwright/screenshots and local vNext state stay outside inspection unless synthetic.
/playwright-report/

# Personal state belongs in the per-user application-data directory.
/Backups/
/saved.json
/provider.dpapi
*.dpapi
