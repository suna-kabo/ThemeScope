{
  "version": "1.0",
  "prices": {
    "provider": "Yahoo Finance chart API",
    "hosts": [
      "query1.finance.yahoo.com",
      "query2.finance.yahoo.com"
    ],
    "interval_seconds": 1.5,
    "history_years": 2,
    "price_field": "close",
    "return_field": "adj_close",
    "fallback_policy": "Try hosts in listed order; open a run-local circuit after HTTP 429; do not substitute raw close for adjusted close."
  },
  "index_constituents": {
    "SPY": {
      "provider": "Wikipedia S&P 500 constituent table",
      "url": "https://en.wikipedia.org/wiki/List_of_S%26P_500_companies"
    },
    "QQQ": {
      "provider": "Nasdaq Nasdaq-100 list",
      "url": "https://api.nasdaq.com/api/quote/list-type/nasdaq100"
    },
    "IWM": {
      "provider": "iShares Russell 2000 ETF official holdings",
      "method": "ishares_csv",
      "url": "https://www.ishares.com/us/products/239710/ishares-russell-2000-etf/latest-holdings.csv",
      "limitations": "IWM holdings are a practical Russell 2000 breadth proxy, not official Russell 2000 constituents."
    }
  },
  "volatility": {
    "provider": "Yahoo Finance chart API",
    "symbols": [
      "^VIX"
    ],
    "description": "VIX is displayed as volatility context only; no constituent breadth or score dependency."
  }
}
